# Bobnet BNCD — used by /api/lockers.ts and the hourly cron snapshot
# Set these as Vercel Environment Variables (Production + Preview), never commit real values.
BOBNET_CLIENT_ID=
BOBNET_CLIENT_SECRET=
# Optional — defaults to 370 (Consign, 67 rue de Cléry)
BOBNET_STORAGE_ID=370

# Postgres — auto-set by Vercel when you connect a Postgres/Neon database
# to the project (Storage tab). No need to set manually.
# DATABASE_URL=

# Cron auth — random string, set manually. Vercel Cron sends it back as
# `Authorization: Bearer $CRON_SECRET`, which /api/cron/snapshot-lockers.ts checks.
# Runs once/day (Hobby plan cron limit) — see vercel.json.
CRON_SECRET=

# Back-office (/admin/*) — HTTP Basic Auth credentials, set manually.
ADMIN_USER=
ADMIN_PASSWORD=
