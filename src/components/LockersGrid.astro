---
const fr = (Astro.currentLocale ?? 'en') === 'fr';

const txt = {
  eyebrow:     fr ? 'En direct'                                     : 'Live',
  title:       fr ? 'Disponibilité'                                 : 'Availability',
  titleAccent: fr ? 'en temps réel.'                                : 'right now.',
  subtitle:    fr ? 'Vérifiez le nombre de casiers libres avant de venir.' : 'Check how many lockers are free before heading over.',
  loading:     fr ? 'Chargement…'                                   : 'Loading…',
  updatedAt:   fr ? 'Mis à jour à'                                  : 'Updated at',
};
---

<section class="section lk-section">
  <div class="container-x">

    <!-- ── Header ─────────────────────────────────────── -->
    <div class="lk-header">
      <div>
        <p class="eyebrow eyebrow-coral">{txt.eyebrow}</p>
        <h1 class="heading-display lk-title">
          {txt.title}<br />
          <span class="pill-coral">{txt.titleAccent}</span>
        </h1>
        <p class="lk-subtitle">{txt.subtitle}</p>
      </div>

      <div class="lk-live-badge">
        <span class="lk-pulse" aria-hidden="true"></span>
        <span id="lk-last-updated">{txt.loading}</span>
      </div>
    </div>

    <!-- ── Summary ─────────────────────────────────────── -->
    <div id="lk-summary" class="lk-summary" data-lang={fr ? 'fr' : 'en'} aria-live="polite" aria-atomic="true">
      <span class="lk-summary-skeleton"></span>
    </div>

  </div>
</section>

<style>
  .lk-section {
    position: relative;
    overflow: hidden;
  }

  .lk-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .lk-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    margin: 0.25em 0 0;
    line-height: 1.05;
  }

  .lk-subtitle {
    margin: 0.75rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1rem;
    max-width: 42ch;
  }

  .lk-live-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    background: var(--color-bg-warm);
    border: 1.5px solid var(--color-rule);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .lk-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    animation: lk-pulse 2s ease-in-out infinite;
  }

  @keyframes lk-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.45; transform: scale(0.75); }
  }

  /* ── Summary banner ────────────────────────────────── */
  .lk-summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.5rem 1.75rem;
    background: var(--color-yellow-soft);
    border: 1.5px solid var(--color-yellow-deep);
    border-radius: 1rem;
    font-weight: 600;
    min-height: 4rem;
  }

  .lk-summary-skeleton {
    display: block;
    width: 240px;
    height: 1em;
    border-radius: 0.4rem;
    background: linear-gradient(90deg,
      var(--color-yellow-deep) 25%,
      color-mix(in srgb, var(--color-yellow-deep) 60%, white) 50%,
      var(--color-yellow-deep) 75%);
    background-size: 200% 100%;
    animation: lk-shimmer 1.4s infinite;
  }

  @keyframes lk-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

<script>
  interface AvailabilitySummary {
    total: number;
    available: number;
    updatedAt: string;
  }

  async function fetchSummary(): Promise<AvailabilitySummary> {
    const res = await fetch('/api/lockers');
    if (!res.ok) throw new Error(`lockers API returned ${res.status}`);
    return res.json();
  }

  function formatHHMM(date: Date): string {
    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  function render(data: AvailabilitySummary) {
    const summary = document.getElementById('lk-summary');
    const lastUpd = document.getElementById('lk-last-updated');
    if (!summary) return;

    const isFr = summary.dataset.lang === 'fr';
    const countTxt = isFr
      ? `${data.available} casier${data.available !== 1 ? 's' : ''} disponible${data.available !== 1 ? 's' : ''} sur ${data.total}`
      : `${data.available} of ${data.total} lockers available`;

    summary.innerHTML = `<span style="font-size:1.3rem">${countTxt}</span>`;

    if (lastUpd) {
      const prefix = isFr ? 'Mis à jour à' : 'Updated at';
      lastUpd.textContent = `${prefix} ${formatHHMM(new Date())}`;
    }
  }

  fetchSummary().then(render).catch(err => console.error('Failed to load lockers summary', err));
  setInterval(() => fetchSummary().then(render).catch(err => console.error('Failed to load lockers summary', err)), 30_000);
</script>
