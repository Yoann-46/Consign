---
import { localizedPath } from '../i18n/ui';
import { DIRECTIONS_URL } from '../lib/site';

const fr = (Astro.currentLocale ?? 'en') === 'fr';

const txt = {
  title:    fr ? 'Disponibilité'                                        : 'Availability',
  accent:   fr ? 'en direct.'                                           : 'right now.',
  subtitle: fr ? 'Combien de casiers sont libres au 67 rue de Cléry, avant de venir.' : 'How many lockers are free at 67 rue de Cléry, before you head over.',
  loading:  fr ? 'Chargement de la disponibilité…'                      : 'Loading availability…',
  free:     fr ? '{n} casiers libres'                           : '{n} lockers free',
  free1:    fr ? '1 casier libre'                               : '1 locker free',
  none:     fr ? 'Tous les casiers sont pris pour le moment.'           : 'All lockers are taken right now.',
  noneHint: fr ? 'Des casiers se libèrent au fil de la journée : réessayez dans un moment.' : 'Lockers free up during the day: try again in a moment.',
  error:    fr ? 'Impossible de charger la disponibilité.'              : 'We couldn’t load availability.',
  errorHint:fr ? 'Le service est peut-être momentanément indisponible. Les casiers restent accessibles 7h–22h, sur place.' : 'The service may be briefly unavailable. The lockers are still open 7am–10pm, on site.',
  retry:    fr ? 'Réessayer'                                            : 'Try again',
  updated:  fr ? 'Mis à jour à'                                         : 'Updated at',
  auto:     fr ? 'Actualisation automatique toutes les 30 s.'           : 'Refreshes every 30 s.',
  directions: fr ? 'Itinéraire'                                         : 'Directions',
  prices:   fr ? 'Voir les tarifs'                                      : 'See prices',
};
---

<section class="section lk-section">
  <div class="container-x">
    <header class="lk-header">
      <h1 class="heading-display lk-title">
        {txt.title} <span class="pill-coral">{txt.accent}</span>
      </h1>
      <p class="lk-subtitle">{txt.subtitle}</p>
    </header>

    <div
      id="lk-status"
      class="lk-status"
      data-state="loading"
      aria-live="polite"
      data-i18n={JSON.stringify(txt)}
      data-lang={fr ? 'fr' : 'en'}
    >
      <p class="lk-main" id="lk-main">
        <span class="lk-spinner" aria-hidden="true"></span>
        <span id="lk-main-text">{txt.loading}</span>
      </p>
      <p class="lk-hint" id="lk-hint"></p>
      <p class="lk-meta" id="lk-meta"></p>
      <div class="lk-actions">
        <button type="button" class="btn btn-ghost lk-retry" id="lk-retry" hidden>{txt.retry}</button>
        <a href={DIRECTIONS_URL} class="btn btn-primary" target="_blank" rel="noopener noreferrer">{txt.directions}</a>
        <a href={localizedPath(fr ? 'fr' : 'en', '/pricing')} class="lk-link">{txt.prices}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .lk-header { margin-bottom: 2rem; }
  .lk-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    margin: 0;
    line-height: 1.1;
  }
  .lk-subtitle {
    margin: 0.9rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1.05rem;
    max-width: 48ch;
  }

  .lk-status {
    max-width: 720px;
    padding: 1.5rem 1.5rem 1.35rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 22px;
    background: #fff;
  }
  .lk-main {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .lk-hint {
    margin: 0.6rem 0 0;
    color: var(--color-ink-soft);
    max-width: 56ch;
  }
  .lk-hint:empty, .lk-meta:empty { display: none; }
  .lk-meta {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .lk-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }
  .lk-link {
    font-weight: 600;
    color: var(--color-ink);
    text-underline-offset: 3px;
  }

  /* Status marker before the main line */
  .lk-spinner {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 2.5px solid var(--color-rule);
    border-top-color: var(--color-ink);
    animation: lk-spin 0.8s linear infinite;
  }
  [data-state='free'] .lk-spinner,
  [data-state='none'] .lk-spinner,
  [data-state='error'] .lk-spinner {
    animation: none;
    border: none;
    width: 12px;
    height: 12px;
  }
  [data-state='free'] .lk-spinner { background: #16a34a; }
  [data-state='none'] .lk-spinner { background: var(--color-coral-dark); }
  [data-state='error'] .lk-spinner { background: var(--color-ink-faint); }
  [data-state='error'] { border-color: var(--color-coral-dark); }
  @keyframes lk-spin { to { transform: rotate(360deg); } }
</style>

<script>
  const box = document.getElementById('lk-status')!;
  const main = document.getElementById('lk-main-text')!;
  const hint = document.getElementById('lk-hint')!;
  const meta = document.getElementById('lk-meta')!;
  const retry = document.getElementById('lk-retry') as HTMLButtonElement;
  const t = JSON.parse(box.dataset.i18n!) as Record<string, string>;

  const hhmm = (d: Date) =>
    d.toLocaleTimeString(box.dataset.lang === 'fr' ? 'fr-FR' : 'en-GB', { hour: '2-digit', minute: '2-digit' });

  async function load(showLoading = false) {
    if (showLoading) {
      box.dataset.state = 'loading';
      main.textContent = t.loading;
      hint.textContent = '';
      retry.hidden = true;
    }
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 10_000);
      const res = await fetch('/api/lockers', { signal: ctrl.signal });
      clearTimeout(timer);
      if (!res.ok) throw new Error(String(res.status));
      const d = (await res.json()) as { total: number; available: number };
      if (typeof d.available !== 'number' || typeof d.total !== 'number') throw new Error('bad payload');
      if (d.available > 0) {
        box.dataset.state = 'free';
        main.textContent = (d.available === 1 ? t.free1 : t.free)
          .replace('{n}', String(d.available))
          .replace('{t}', String(d.total));
        hint.textContent = '';
      } else {
        box.dataset.state = 'none';
        main.textContent = t.none;
        hint.textContent = t.noneHint;
      }
      meta.textContent = `${t.updated} ${hhmm(new Date())} · ${t.auto}`;
      retry.hidden = true;
    } catch {
      box.dataset.state = 'error';
      main.textContent = t.error;
      hint.textContent = t.errorHint;
      meta.textContent = '';
      retry.hidden = false;
    }
  }

  retry.addEventListener('click', () => load(true));
  load();
  setInterval(() => { if (!document.hidden && box.dataset.state !== 'error') load(); }, 30_000);
</script>
