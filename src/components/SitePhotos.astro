---
/**
 * Three on-site photos, ready to receive images. Each one renders only when
 * its file exists in src/assets/photos/ (see README there). Fixed 4:3 frame,
 * explicit width/height: no layout shift. With no photo at all, the whole
 * block renders nothing.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const find = (name: string) =>
  Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === name)?.[1]
    .default;

const slots = [
  { name: 'devanture', caption: t('photos.storefront') },
  { name: 'machine', caption: t('photos.machine') },
  { name: 'casier', caption: t('photos.locker') },
]
  .map((s) => ({ ...s, img: find(s.name) }))
  .filter((s) => s.img);
---

{slots.length > 0 && (
  <div class="photos" aria-label={t('photos.title')}>
    {slots.map((s) => (
      <figure class="photo" data-reveal>
        <Image
          src={s.img!}
          alt={s.caption}
          widths={[480, 800, 1200]}
          sizes="(min-width: 900px) 33vw, 100vw"
          class="photo-img"
          loading="lazy"
        />
        <figcaption>{s.caption}</figcaption>
      </figure>
    ))}
  </div>
)}

<style>
  .photos {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 700px) {
    .photos { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); }
  }
  .photo { margin: 0; }
  .photo-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 18px;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  .photo figcaption {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    opacity: 0.8;
  }
</style>
