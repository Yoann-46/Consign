---
import { useTranslations, localizedPath } from '../i18n/ui';
import { DIRECTIONS_URL, PRICES, PHONE_TEL, PHONE_DISPLAY, WHATSAPP_URL } from '../lib/site';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);
const fr = lang === 'fr';
const eur = (n: number) => (fr ? `${n} €` : `€${n}`);
const sizes = [
  { key: 'm', name: t('card.medium'), ...PRICES.m },
  { key: 'l', name: t('card.large'), ...PRICES.l },
] as const;
---

<article class="lcard" id="casier" aria-labelledby="lcard-title">
  <header class="lcard-head">
    <h2 id="lcard-title" class="lcard-title">{t('card.title')} <span class="lcard-place">· Sentier</span></h2>
    <a
      href={localizedPath(lang, '/lockers')}
      class="lcard-live"
      data-live
      data-lang={lang}
      data-loading={t('card.live.loading')}
      data-free={t('card.live.free')}
      data-free1={t('card.live.free1')}
      data-none={t('card.live.none')}
      data-error={t('card.live.error')}
      aria-live="polite"
    >
      <span class="lcard-live-dot" aria-hidden="true"></span>
      <span data-live-text>{t('card.live.error')}</span>
    </a>
  </header>

  <dl class="lcard-facts">
    <div class="lcard-fact">
      <dt>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></svg>
        <span class="sr-only">{fr ? 'Adresse' : 'Address'}</span>
      </dt>
      <dd><strong>67 rue de Cléry, 75002 Paris</strong><span>{t('card.where')}</span></dd>
    </div>
    <div class="lcard-fact">
      <dt>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="14" rx="4" /><path d="M9 17l-2 4M15 17l2 4" /><path d="M8.5 10h7" /></svg>
        <span class="sr-only">{fr ? 'Métro' : 'Metro'}</span>
      </dt>
      <dd>{t('card.metro')}</dd>
    </div>
    <div class="lcard-fact">
      <dt>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></svg>
        <span class="sr-only">{fr ? 'Horaires' : 'Hours'}</span>
      </dt>
      <dd>{t('card.hours')}</dd>
    </div>
  </dl>

  <table class="lcard-prices">
    <caption class="sr-only">{t('card.prices')}</caption>
    <thead>
      <tr>
        <th scope="col">{t('card.size')}</th>
        <th scope="col">{t('card.half')}</th>
        <th scope="col">{t('card.day')}</th>
      </tr>
    </thead>
    <tbody>
      {sizes.map((s) => (
        <tr>
          <th scope="row">
            <span class="lcard-size">{s.name}</span>
            <span class="lcard-dims">{s.dims} cm</span>
          </th>
          <td>{eur(s.half)}</td>
          <td>{eur(s.day)}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p class="lcard-pay">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2.5" /><path d="M2.5 10h19M6.5 15h4" /></svg>
    {t('card.pay')}
  </p>

  <div class="lcard-actions">
    <a
      href={DIRECTIONS_URL}
      class="btn btn-primary"
      target="_blank"
      rel="noopener noreferrer"
      onclick="if(window.gtag){window.gtag('event','get_directions_click',{event_category:'engagement',event_label:'locker_card'});}"
    >
      {t('cta.directions')}
      <svg class="lcard-ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
    </a>
    <a href={localizedPath(lang, '/pricing')} class="lcard-link">{t('card.allPrices')}</a>
  </div>

  <p class="lcard-help">
    <span>{t('card.help')}</span>
    <a href={PHONE_TEL}>{PHONE_DISPLAY}</a>
    <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">WhatsApp</a>
  </p>
</article>

<style>
  .lcard {
    background: #fff;
    border: 1.5px solid var(--color-ink);
    border-radius: 22px;
    padding: 1.5rem 1.25rem 1.35rem;
    display: grid;
    gap: 1.25rem;
    width: 100%;
    max-width: 560px;
    scroll-margin-top: 5.5rem;
  }
  @media (min-width: 560px) {
    .lcard { padding: 1.75rem 1.75rem 1.5rem; }
  }

  .lcard-head {
    display: grid;
    gap: 0.5rem;
  }
  .lcard-title {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-ink);
  }
  .lcard-place {
    font-weight: 600;
    color: var(--color-ink-soft);
  }

  /* Live availability — the one pulsing dot kept on the site */
  .lcard-live {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 32px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }
  .lcard-live:hover { text-decoration-color: currentColor; }
  .lcard-live-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-ink-faint);
    flex-shrink: 0;
  }
  .lcard-live[data-state='free'] .lcard-live-dot {
    background: #16a34a;
    box-shadow: 0 0 0 0 color-mix(in srgb, #16a34a 45%, transparent);
    animation: live-pulse 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .lcard-live[data-state='none'] .lcard-live-dot { background: var(--color-coral-dark); }
  @keyframes live-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, #16a34a 45%, transparent); }
    70%, 100% { box-shadow: 0 0 0 7px color-mix(in srgb, #16a34a 0%, transparent); }
  }

  .lcard-facts {
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }
  .lcard-fact {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 0.7rem;
    align-items: start;
  }
  .lcard-fact dt { margin: 0; padding-top: 0.15rem; }
  .lcard-fact svg,
  .lcard-pay svg,
  .lcard-ext {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lcard-fact dt svg { color: var(--color-coral-dark); }
  .lcard-fact dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-ink);
  }
  .lcard-fact dd strong { display: block; font-weight: 700; }
  .lcard-fact dd span { color: var(--color-ink-soft); font-size: 0.92rem; }

  .lcard-prices {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .lcard-prices thead th {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    text-align: right;
    padding: 0 0 0.45rem;
    border-bottom: 1.5px solid var(--color-ink);
  }
  .lcard-prices thead th:first-child { text-align: left; }
  .lcard-prices tbody th {
    text-align: left;
    font-weight: 400;
    padding: 0.65rem 0.5rem 0.65rem 0;
  }
  .lcard-prices tbody td {
    text-align: right;
    font-weight: 700;
    font-size: 1.05rem;
    padding: 0.65rem 0 0.65rem 0.75rem;
    white-space: nowrap;
  }
  .lcard-prices tbody tr + tr > * { border-top: 1px solid var(--color-rule); }
  .lcard-size {
    display: block;
    font-weight: 700;
    color: var(--color-ink);
  }
  .lcard-dims {
    display: block;
    font-size: 0.82rem;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }

  .lcard-pay {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-ink-soft);
  }
  .lcard-pay svg { flex-shrink: 0; color: var(--color-ink); }

  .lcard-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }
  .lcard-actions .btn { flex: 1 1 auto; }
  @media (min-width: 560px) {
    .lcard-actions .btn { flex: 0 0 auto; }
  }
  .lcard-link {
    font-weight: 600;
    color: var(--color-ink);
    text-underline-offset: 3px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .lcard-help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1rem;
    margin: -0.25rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.92rem;
    color: var(--color-ink-soft);
  }
  .lcard-help a {
    font-weight: 700;
    color: var(--color-ink);
    text-underline-offset: 3px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Live count from /api/lockers. The link (to /lockers) is the fallback.
  const el = document.querySelector<HTMLElement>('[data-live]');
  const text = el?.querySelector<HTMLElement>('[data-live-text]');
  async function refresh() {
    if (!el || !text) return;
    try {
      const res = await fetch('/api/lockers');
      if (!res.ok) throw new Error(String(res.status));
      const d = (await res.json()) as { total: number; available: number };
      if (typeof d.available !== 'number') throw new Error('bad payload');
      if (d.available > 0) {
        el.dataset.state = 'free';
        text.textContent = (d.available === 1 ? el.dataset.free1! : el.dataset.free!).replace('{n}', String(d.available)).replace('{t}', String(d.total));
      } else {
        el.dataset.state = 'none';
        text.textContent = el.dataset.none!;
      }
    } catch {
      el.dataset.state = 'error';
      text.textContent = el.dataset.error!;
    }
  }
  if (el && text) {
    text.textContent = el.dataset.loading!;
    refresh();
    setInterval(() => { if (!document.hidden) refresh(); }, 60_000);
  }
</script>
