---
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Decorative background -->
  <div class="hero-bg bg-grid" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>

  <div class="container-x hero-inner">
    <p class="hero-wordmark" data-hero-anim="wordmark" aria-hidden="true">
      Consign<span class="wordmark-dot">.</span>
    </p>

    <h1 id="hero-title" class="heading-display hero-title">
      <span class="word">
        <span class="word-inner" data-hero-anim="word">{t('hero.title.a')}</span>
      </span>
      <span class="word">
        <span class="word-inner has-pill" data-hero-anim="word">
          <span class="pill pill-coral-bg" data-hero-anim="pill"></span>
          <span class="pill-text">{t('hero.title.b')}</span>
        </span>
      </span>
      <br />
      <span class="word">
        <span class="word-inner" data-hero-anim="word">{t('hero.title.c')}</span>
      </span>
      <span class="word">
        <span class="word-inner has-pill" data-hero-anim="word">
          <span class="pill pill-yellow-bg" data-hero-anim="pill"></span>
          <span class="pill-text">{t('hero.title.d')}</span>
        </span>
      </span>
    </h1>

    <p class="hero-subtitle" data-hero-anim="subtitle">{t('hero.subtitle')}</p>

    <div class="hero-ctas" data-hero-anim="ctas">
      <a href="#locations" class="btn btn-primary">
        {t('hero.cta.primary')}
        <span aria-hidden="true">→</span>
      </a>
      <a href="#how" class="btn btn-ghost">
        {t('hero.cta.secondary')}
      </a>
    </div>

    <!-- Stats row -->
    <div class="hero-stats" data-hero-anim="stats">
      <div class="stat">
        <span class="stat-value">{t('hero.stat.uptime')}</span>
        <span class="stat-label">{t('hero.stat.uptime.label')}</span>
      </div>
      <div class="stat stat-divider">
        <span class="stat-value">{t('hero.stat.from')}</span>
        <span class="stat-label">{t('hero.stat.from.label')}</span>
      </div>
      <div class="stat">
        <span class="stat-value">{t('hero.stat.location')}</span>
        <span class="stat-label">{t('hero.stat.location.label')}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Mobile: more breathing room at top + comfortable bottom space */
    padding-block: 3rem 4rem;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: -10% -10% -30% -10%;
    z-index: -2;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse at 50% 30%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 30%, black 30%, transparent 75%);
  }

  .hero-blob {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.6;
    pointer-events: none;
  }
  .hero-blob-1 {
    width: 32rem;
    height: 32rem;
    background: var(--color-yellow);
    top: -10%;
    right: -10%;
  }
  .hero-blob-2 {
    width: 26rem;
    height: 26rem;
    background: var(--color-coral-soft);
    bottom: -20%;
    left: -10%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Brand wordmark sitting above the slogan — 15% smaller than the slogan */
  .hero-wordmark {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 11vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.92;
    color: var(--color-ink);
    /* Mobile: more space between Consign and the slogan */
    margin: 0 0 0.35em;
    opacity: 0;
    transform: translateY(20px);
  }
  .wordmark-dot {
    color: var(--color-coral);
  }

  .hero-title {
    font-size: clamp(3.25rem, 13vw, 9.5rem);
    /* Mobile: more breathing room before the subtitle */
    margin: 0 0 1.75rem;
    color: var(--color-ink);
  }

  .hero-title .word {
    display: inline-block;
    overflow: visible;
    margin-right: 0.18em;
    clip-path: inset(-25% 0 -10% 0);
  }
  .hero-title .word:last-child { margin-right: 0; }

  .hero-title .word-inner {
    display: inline-block;
    position: relative;
    transform: translateY(100%);
    will-change: transform;
  }

  .has-pill {
    position: relative;
    z-index: 0;
    padding-inline: 0.18em 0.22em;
    isolation: isolate;
  }
  .pill {
    position: absolute;
    inset: 0.12em -0.04em 0.05em -0.04em;
    z-index: 0;
    border-radius: 0.14em;
    transform-origin: left center;
    transform: scaleX(0);
  }
  .pill-coral-bg {
    background: var(--color-coral);
  }
  .pill-yellow-bg {
    background: var(--color-yellow);
  }
  .pill-text {
    position: relative;
    z-index: 1;
    color: var(--color-ink);
  }

  .hero-subtitle {
    max-width: 38ch;
    margin: 0 0 1.5rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.45;
    color: var(--color-ink-soft);
    opacity: 0;
    transform: translateY(20px);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.65rem;
    margin-bottom: 2.25rem;
    opacity: 0;
    transform: translateY(20px);
  }
  /* Mobile: compact so the two buttons fit side by side at 375px */
  .hero-ctas .btn {
    padding: 0.6rem 1.05rem;
    font-size: 0.85rem;
    min-height: 42px;
    gap: 0.4rem;
  }
  /* Tablet+: let the global .btn desktop size apply */
  @media (min-width: 560px) {
    .hero-ctas { gap: 1rem; }
    .hero-ctas .btn {
      padding: 1.05rem 1.85rem;
      font-size: 1.1rem;
      min-height: 56px;
      gap: 0.55rem;
    }
  }

  /* Stats — compact, all on a single horizontal row even on 375px */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    width: 100%;
    max-width: 680px;
    border: 1.5px solid var(--color-ink);
    border-radius: 14px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-bg) 75%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.7rem 0.5rem;
    opacity: 0;
    transform: translateY(16px);
    border-right: 1.5px solid var(--color-ink);
    text-align: center;
    align-items: center;
  }
  .stat:last-child { border-right: none; }
  .stat-value {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .stat-label {
    font-size: 0.68rem;
    color: var(--color-ink-soft);
    line-height: 1.2;
  }

  @media (min-width: 560px) {
    .stat {
      padding: 1rem 1.1rem;
      text-align: left;
      align-items: flex-start;
    }
    .stat-value { font-size: 1.5rem; }
    .stat-label { font-size: 0.85rem; }
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3.5rem, 7vw, 5.5rem);
    }
    .hero-title {
      letter-spacing: -0.035em;
    }
    .hero-subtitle {
      font-size: 1.35rem;
      max-width: 44ch;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const wordmark = document.querySelector<HTMLElement>('[data-hero-anim="wordmark"]');
  const wordInners = document.querySelectorAll<HTMLElement>('[data-hero-anim="word"]');
  const pills = document.querySelectorAll<HTMLElement>('[data-hero-anim="pill"]');
  const coralPillText = document.querySelector<HTMLElement>('.pill-coral-bg + .pill-text');
  const subtitle = document.querySelector<HTMLElement>('[data-hero-anim="subtitle"]');
  const ctas = document.querySelector<HTMLElement>('[data-hero-anim="ctas"]');
  const stats = document.querySelectorAll<HTMLElement>('[data-hero-anim="stats"] .stat');

  if (reduce) {
    if (wordmark) gsap.set(wordmark, { opacity: 1, y: 0 });
    gsap.set(wordInners, { y: '0%' });
    gsap.set(pills, { scaleX: 1 });
    if (coralPillText) gsap.set(coralPillText, { color: '#ffffff' });
    gsap.set([subtitle, ctas], { opacity: 1, y: 0 });
    gsap.set(stats, { opacity: 1, y: 0 });
  } else {
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

    // 0. Brand wordmark fades up first as the curtain raise
    if (wordmark) {
      tl.to(wordmark, {
        opacity: 1,
        y: 0,
        duration: 0.95,
        ease: 'power3.out',
      });
    }

    tl.to(
      wordInners,
      {
        y: '0%',
        duration: 1.1,
        stagger: 0.085,
      },
      '-=0.55',
    );

    tl.to(
      pills,
      {
        scaleX: 1,
        duration: 0.6,
        ease: 'power3.out',
        stagger: 0.18,
      },
      '-=0.7',
    );

    if (coralPillText) {
      tl.to(
        coralPillText,
        {
          color: '#ffffff',
          duration: 0.25,
          ease: 'power1.out',
        },
        '-=0.45',
      );
    }

    tl.to(
      [subtitle, ctas],
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.12,
        ease: 'power2.out',
      },
      '-=0.4',
    );

    tl.to(
      stats,
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.08,
        ease: 'power2.out',
      },
      '-=0.4',
    );
  }
</script>
