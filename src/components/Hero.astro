---
import { useTranslations } from '../i18n/ui';
import LockerCard from './LockerCard.astro';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-x hero-inner">
    <div class="hero-main">
    <h1 id="hero-title" class="heading-display hero-title">
      <span class="word">
        <span class="word-inner" data-hero-anim="word">{t('hero.title.a')}</span>
      </span>
      <span class="word">
        <span class="word-inner has-pill" data-hero-anim="word">
          <span class="pill pill-coral-bg" data-hero-anim="pill"></span>
          <span class="pill-text">{t('hero.title.b')}</span>
        </span>
      </span>
      <br />
      <span class="word">
        <span class="word-inner" data-hero-anim="word">{t('hero.title.c')}</span>
      </span>
      <span class="word">
        <span class="word-inner has-pill" data-hero-anim="word">
          <span class="pill pill-yellow-bg" data-hero-anim="pill"></span>
          <span class="pill-text">{t('hero.title.d')}</span>
        </span>
      </span>
    </h1>

    <p class="hero-subtitle">{t('hero.subtitle')}</p>

    <div class="hero-ctas">
      <a href="#casier" class="btn btn-primary cta-to-card">
        {t('cta.seeLocker')}
        <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
      </a>
      <a href="#how" class="btn btn-ghost">
        {t('hero.cta.secondary')}
      </a>
    </div>

    <!-- Stats row -->
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-value">{t('hero.stat.uptime')}</span>
        <span class="stat-label">{t('hero.stat.uptime.label')}</span>
      </div>
      <div class="stat stat-divider">
        <span class="stat-value">{t('hero.stat.from')}</span>
        <span class="stat-label">{t('hero.stat.from.label')}</span>
      </div>
      <div class="stat">
        <span class="stat-value">{t('hero.stat.location')}</span>
        <span class="stat-label">{t('hero.stat.location.label')}</span>
      </div>
    </div>
    </div>

    <div class="hero-card">
      <LockerCard />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Mobile: more breathing room at top + comfortable bottom space */
    padding-block: 3rem 4rem;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: 2.75rem;
  }
  .hero-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .hero-card {
    display: flex;
    justify-content: center;
  }

  /* Desktop: the locker card fills the right half of the hero */
  @media (min-width: 1100px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(400px, 1fr);
      column-gap: clamp(2.5rem, 4vw, 4.5rem);
      align-items: center;
    }
    .hero-card { justify-content: flex-end; }
  }

  /* "See the locker" scrolls to the card when it sits below the fold;
     on desktop the card (with its Directions button) is already beside. */
  @media (min-width: 1100px) {
    .cta-to-card { display: none; }
  }
  .cta-icon {
    width: 1.05em;
    height: 1.05em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-title {
    /* Lines are set by hand with <br>: no balancing */
    text-wrap: wrap;
    white-space: nowrap;
    /* "you explore." with its pill must fit 320–390 px screens */
    font-size: clamp(2.25rem, 11vw, 9.5rem);
    /* Room for the descenders of "you explore." before the subtitle */
    margin: 0 0 calc(1.25rem + 0.12em);
    color: var(--color-ink);
  }

  .hero-title .word {
    display: inline-block;
    overflow: visible;
    margin-right: 0.18em;
  }
  .hero-title .word:last-child { margin-right: 0; }

  .hero-title .word-inner {
    display: inline-block;
    position: relative;
  }

  .has-pill {
    position: relative;
    z-index: 0;
    padding-inline: 0.18em 0.22em;
    isolation: isolate;
  }
  .pill {
    position: absolute;
    inset: 0.12em -0.04em 0.05em -0.04em;
    z-index: 0;
    border-radius: 0.14em;
    transform-origin: left center;
  }
  .pill-coral-bg {
    background: var(--color-coral);
  }
  .pill-yellow-bg {
    background: var(--color-yellow);
  }
  .pill-text {
    position: relative;
    z-index: 1;
    color: var(--color-ink);
  }
  .pill-coral-bg + .pill-text {
    color: #fff;
  }

  .hero-subtitle {
    max-width: 38ch;
    margin: 0 0 1.5rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 2.25rem;
  }
  /* Mobile: compact so the two buttons fit side by side at 375px */
  .hero-ctas .btn {
    white-space: nowrap;
    padding: 0.6rem 1.05rem;
    font-size: 0.85rem;
    min-height: 42px;
    gap: 0.4rem;
  }
  /* Tablet+: let the global .btn desktop size apply */
  @media (min-width: 560px) {
    .hero-ctas { gap: 1rem; }
    .hero-ctas .btn {
      padding: 1.05rem 1.85rem;
      font-size: 1.1rem;
      min-height: 56px;
      gap: 0.55rem;
    }
  }

  /* Stats — compact, all on a single horizontal row even on 375px */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    width: 100%;
    max-width: 680px;
    border: 1.5px solid var(--color-ink);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-bg);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.7rem 0.5rem;
    border-right: 1.5px solid var(--color-ink);
    text-align: center;
    align-items: center;
  }
  .stat:last-child { border-right: none; }
  .stat-value {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .stat-label {
    font-size: 0.75rem;
    color: var(--color-ink-soft);
    line-height: 1.2;
  }

  @media (min-width: 560px) {
    .stat {
      padding: 1rem 1.1rem;
      text-align: left;
      align-items: flex-start;
    }
    .stat-value { font-size: 1.5rem; }
    .stat-label { font-size: 0.85rem; }
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3.5rem, 7vw, 5.5rem);
    }
    .hero-title {
      letter-spacing: -0.035em;
    }
  }
  @media (min-width: 1100px) {
    .hero-title {
      font-size: clamp(4.75rem, 6.6vw, 6.25rem);
    }
    .hero-subtitle {
      font-size: 1.35rem;
      max-width: 44ch;
    }
  }
  /* Entrance: pure CSS, so nothing depends on JS. Everything is visible by
     default; the keyframes only describe where it comes from. Total < 0.9 s.
     prefers-reduced-motion collapses durations globally (global.css). */
  @media (prefers-reduced-motion: no-preference) {
    .hero-title .word-inner {
      animation: hero-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-title .word:nth-of-type(2) .word-inner { animation-delay: 0.05s; }
    .hero-title .word:nth-of-type(3) .word-inner { animation-delay: 0.1s; }
    .hero-title .word:nth-of-type(4) .word-inner { animation-delay: 0.15s; }
    .pill {
      animation: pill-sweep 0.45s cubic-bezier(0.65, 0, 0.35, 1) 0.25s both;
    }
    .word:nth-of-type(4) .pill { animation-delay: 0.4s; }
    .pill-coral-bg + .pill-text {
      animation: pill-ink 0.25s ease-out 0.4s both;
    }
    .hero-subtitle,
    .hero-ctas,
    .hero-stats,
    .hero-card {
      animation: hero-fade 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
    }
    .hero-ctas { animation-delay: 0.2s; }
    .hero-stats { animation-delay: 0.25s; }
    .hero-card { animation-delay: 0.3s; }
  }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(0.3em); }
  }
  @keyframes pill-sweep {
    from { transform: scaleX(0); }
  }
  @keyframes pill-ink {
    from { color: var(--color-ink); }
  }
  @keyframes hero-fade {
    from { opacity: 0; transform: translateY(10px); }
  }
</style>

