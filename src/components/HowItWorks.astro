---
import { useTranslations } from '../i18n/ui';
import SitePhotos from './SitePhotos.astro';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);

const steps = [1, 2, 3, 4].map((n) => ({
  n,
  title: t(`how.step${n}.title` as 'how.step1.title'),
  desc: t(`how.step${n}.desc` as 'how.step1.desc'),
}));
---

<section class="how" id="how" aria-labelledby="how-title">
  <div class="container-x">
    <header class="how-header" data-reveal>
      <h2 id="how-title" class="heading-display how-title">
        {t('how.title')} <span class="how-title-accent">{t('how.title.accent')}</span>
      </h2>
      <p class="how-lede">{t('how.lede')}</p>
    </header>

    <ol class="how-steps">
      {steps.map((s) => (
        <li class="step" data-reveal>
          <div class="step-art" aria-hidden="true">
            {s.n === 1 && (
              /* Two locker doors: Medium (short) and Large (tall, selected) */
              <svg viewBox="0 0 120 90">
                <rect x="22" y="40" width="34" height="40" rx="4" class="ln" />
                <circle cx="49" cy="60" r="1.8" class="dot" />
                <rect x="64" y="10" width="34" height="70" rx="4" class="sel" />
                <circle cx="91" cy="45" r="1.8" class="dot-ink" />
                <path d="M14 80h92" class="ln" />
              </svg>
            )}
            {s.n === 2 && (
              /* Screen with three duration choices, the last one selected */
              <svg viewBox="0 0 120 90">
                <rect x="14" y="8" width="92" height="66" rx="8" class="ln" />
                <circle cx="60" cy="26" r="8" class="ln" />
                <path d="M60 21.5V26l3 2" class="ln" />
                <rect x="22" y="46" width="22" height="16" rx="5" class="ln" />
                <rect x="49" y="46" width="22" height="16" rx="5" class="ln" />
                <rect x="76" y="46" width="22" height="16" rx="5" class="sel-y" />
                <path d="M48 74l-4 10M72 74l4 10" class="ln" />
              </svg>
            )}
            {s.n === 3 && (
              /* Card tapped on the reader, contactless waves */
              <svg viewBox="0 0 120 90">
                <rect x="58" y="14" width="44" height="66" rx="7" class="ln" />
                <rect x="66" y="22" width="28" height="16" rx="3" class="ln" />
                <path d="M72 52a6 6 0 0 1 0 8M78 48a12 12 0 0 1 0 16" class="ln" />
                <g transform="rotate(-14 34 50)">
                  <rect x="12" y="34" width="46" height="30" rx="4" class="sel" />
                  <path d="M12 43h46" class="ink" />
                  <rect x="18" y="51" width="10" height="7" rx="1.5" class="ink" />
                </g>
              </svg>
            )}
            {s.n === 4 && (
              /* Phone showing a QR code, held toward the scanner */
              <svg viewBox="0 0 120 90">
                <rect x="20" y="10" width="40" height="72" rx="7" class="ln" />
                <path d="M34 16h12" class="ln" />
                <rect x="27" y="28" width="26" height="26" rx="2" class="sel-y" />
                <path d="M31 32h6v6h-6zM43 32h6v6h-6zM31 44h6v6h-6zM43 44h2v2h-2zM47 48h2v2h-2zM43 48h2" class="ink" />
                <path d="M72 30h8M72 30v8M100 30h-8M100 30v8M72 60h8M72 60v-8M100 60h-8M100 60v-8" class="ln" />
                <path d="M68 45h36" class="coral" />
              </svg>
            )}
          </div>
          <span class="step-num">{String(s.n).padStart(2, '0')}</span>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-desc">{s.desc}</p>
        </li>
      ))}
    </ol>

    <SitePhotos />
  </div>
</section>

<style>
  .how {
    position: relative;
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .how-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    max-width: 720px;
  }
  .how-title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    margin: 0;
    color: var(--color-bg);
  }
  .how-title-accent {
    color: var(--color-yellow);
    font-style: italic;
    font-weight: 300;
  }
  .how-lede {
    margin: 1rem 0 0;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: color-mix(in srgb, var(--color-bg) 82%, transparent);
  }

  .how-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-bg) 18%, transparent);
  }

  /* Mobile: illustration left, text right */
  .step {
    display: grid;
    grid-template-columns: 96px 1fr;
    grid-template-areas:
      'art num'
      'art title'
      'art desc';
    grid-template-rows: auto auto 1fr;
    column-gap: 1.1rem;
    row-gap: 0.3rem;
    align-content: start;
    padding: 1.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-bg) 18%, transparent);
  }

  .step-art {
    grid-area: art;
    align-self: start;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-bg) 7%, transparent);
    padding: 0.5rem;
  }
  .step-art svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .step-art :is(.ln, .ink, .coral, .sel, .sel-y) {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .step-art .ln { stroke: var(--color-bg); }
  .step-art .ink { stroke: var(--color-ink); }
  .step-art .coral { stroke: var(--color-coral); }
  .step-art .sel { fill: var(--color-coral); stroke: var(--color-coral); }
  .step-art .sel-y { fill: var(--color-yellow); stroke: var(--color-yellow); }
  .step-art .dot { fill: var(--color-bg); }
  .step-art .dot-ink { fill: var(--color-ink); }

  .step-num {
    grid-area: num;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-coral);
    font-variant-numeric: tabular-nums;
  }
  .step-title {
    grid-area: title;
    margin: 0;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-bg);
  }
  .step-desc {
    grid-area: desc;
    margin: 0.2rem 0 0;
    max-width: 52ch;
    color: color-mix(in srgb, var(--color-bg) 78%, transparent);
    font-size: 0.97rem;
    line-height: 1.5;
  }

  /* Desktop: four columns, illustration on top */
  @media (min-width: 900px) {
    .how-steps {
      grid-template-columns: repeat(4, 1fr);
      border-top: none;
      gap: clamp(1.5rem, 2.5vw, 2.5rem);
    }
    .step {
      grid-template-columns: 1fr;
      grid-template-areas:
        'art'
        'num'
        'title'
        'desc';
      grid-template-rows: auto;
      row-gap: 0.5rem;
      padding: 0;
      border-bottom: none;
    }
    .step-art {
      padding: 1.25rem 1.5rem;
      margin-bottom: 0.9rem;
    }
    .step-title { font-size: clamp(1.35rem, 1.9vw, 1.6rem); }
    .step-desc { font-size: 1rem; }
  }
</style>
