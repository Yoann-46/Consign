---
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);

const steps = [
  {
    num: '01',
    title: t('how.step1.title'),
    desc: t('how.step1.desc'),
    accent: 'coral',
    icon: 'pin',
  },
  {
    num: '02',
    title: t('how.step2.title'),
    desc: t('how.step2.desc'),
    accent: 'yellow',
    icon: 'clock-check',
  },
  {
    num: '03',
    title: t('how.step3.title'),
    desc: t('how.step3.desc'),
    accent: 'coral',
    icon: 'lock',
  },
  {
    num: '04',
    title: t('how.step4.title'),
    desc: t('how.step4.desc'),
    accent: 'yellow',
    icon: 'compass',
  },
] as const;
---

<section class="how" id="how" aria-labelledby="how-title">
  <div class="container-x">
    <header class="how-header" data-how-anim="header">
      <span class="eyebrow how-eyebrow">{t('how.eyebrow')}</span>
      <h2 id="how-title" class="heading-display how-title">
        {t('how.title')} <span class="how-title-accent">{t('how.title.accent')}</span>
      </h2>
    </header>

    <ol class="how-steps">
      {steps.map((s) => (
        <li class={`step accent-${s.accent}`} data-how-anim="step">
          <div class="step-icon" aria-hidden="true">
            {s.icon === 'pin' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            )}
            {s.icon === 'clock-check' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M7.75 12.5 10.5 15.25 16.25 9.5" />
              </svg>
            )}
            {s.icon === 'lock' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="10.5" width="16" height="10.5" rx="2.5" />
                <path d="M7.5 10.5V7a4.5 4.5 0 0 1 9 0v3.5" />
                <circle cx="12" cy="15.5" r="1.4" fill="currentColor" stroke="none" />
              </svg>
            )}
            {s.icon === 'compass' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="m15.5 8.5-2 5.5-5.5 2 2-5.5 5.5-2z" />
              </svg>
            )}
          </div>

          <span class="step-num">{s.num}</span>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-desc">{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how {
    position: relative;
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: var(--color-ink);
    color: var(--color-bg);
    overflow: hidden;
  }

  /* Subtle radial accent in the background */
  .how::before {
    content: '';
    position: absolute;
    inset: -20% -20% auto auto;
    width: 38rem;
    height: 38rem;
    background: radial-gradient(circle at center, color-mix(in srgb, var(--color-coral) 18%, transparent), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .container-x {
    position: relative;
    z-index: 1;
  }

  .how-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    max-width: 720px;
    opacity: 0;
    transform: translateY(20px);
  }

  .how-eyebrow {
    color: var(--color-coral);
    display: inline-block;
    margin-bottom: 1rem;
  }

  .how-title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    margin: 0;
    color: var(--color-bg);
  }
  .how-title-accent {
    color: var(--color-yellow);
    font-style: italic;
    font-weight: 300;
  }

  .how-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-bg) 18%, transparent);
  }

  .step {
    /* Mobile: icon + title on same row, num right, desc full width below */
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'icon  title  num'
      'desc  desc   desc';
    column-gap: 0.85rem;
    row-gap: 0.5rem;
    align-items: center;
    padding: 1.25rem 0 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-bg) 18%, transparent);
    opacity: 0;
    transform: translateY(24px);
  }

  .step-icon {
    grid-area: icon;
    width: 32px;
    height: 32px;
    color: var(--color-bg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .step-icon svg {
    width: 100%;
    height: 100%;
  }

  .step-num {
    grid-area: num;
    justify-self: end;
    align-self: center;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .accent-coral .step-num { color: var(--color-coral); }
  .accent-yellow .step-num { color: var(--color-yellow); }

  .step-title {
    grid-area: title;
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-bg);
    line-height: 1.1;
  }

  .step-desc {
    grid-area: desc;
    margin: 0;
    max-width: 52ch;
    color: color-mix(in srgb, var(--color-bg) 72%, transparent);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Desktop — 4 columns */
  @media (min-width: 900px) {
    .how-steps {
      grid-template-columns: repeat(4, 1fr);
      border-top: none;
    }
    .step {
      grid-template-columns: 1fr;
      grid-template-areas:
        'icon'
        'num'
        'title'
        'desc';
      row-gap: 1.25rem;
      /* Equal horizontal padding so content breathes around the dividers */
      padding: 2.25rem 2.5rem 2.5rem 2.5rem;
      border-bottom: none;
      border-right: 1px solid color-mix(in srgb, var(--color-bg) 18%, transparent);
      position: relative;
    }
    .step:first-child { padding-left: 0; }
    .step:last-child { border-right: none; padding-right: 0; }
    .step-num {
      justify-self: start;
      font-size: 3rem;
    }
    .step-icon {
      width: 40px;
      height: 40px;
    }
    .step-title {
      font-size: clamp(1.65rem, 3vw, 2rem);
    }
    .step-desc {
      font-size: 1rem;
    }
  }

  @media (min-width: 1100px) {
    .step {
      padding-block: 2.5rem 3rem;
      padding-inline: 3rem;
    }
    .step:first-child { padding-left: 0; }
    .step:last-child { padding-right: 0; }
    .step-num {
      font-size: 3.5rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const header = document.querySelector<HTMLElement>('[data-how-anim="header"]');
  const steps = document.querySelectorAll<HTMLElement>('[data-how-anim="step"]');

  if (reduce) {
    if (header) gsap.set(header, { opacity: 1, y: 0 });
    gsap.set(steps, { opacity: 1, y: 0 });
  } else {
    // Header reveals first, slower, when the heading is well into view
    if (header) {
      gsap.to(header, {
        opacity: 1,
        y: 0,
        duration: 1.1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: header,
          start: 'top 70%',
          once: true,
        },
      });
    }

    // Steps reveal one by one, only once the steps row is well into view.
    // Slower duration + larger stagger so the cascade is actually catchable.
    gsap.to(steps, {
      opacity: 1,
      y: 0,
      duration: 1.4,
      ease: 'power3.out',
      stagger: 0.28,
      scrollTrigger: {
        trigger: '.how-steps',
        start: 'top 65%',
        once: true,
      },
    });
  }
</script>
