---
import { useTranslations, localizedPath } from '../i18n/ui';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-x footer-inner">
    <div class="footer-brand">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">Consign</span>
      </div>
      <p class="footer-tagline">{t('footer.tagline')}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-col">
        <span class="eyebrow">Product</span>
        <a href="#how">{t('nav.how')}</a>
        <a href="#locations">{t('nav.locations')}</a>
        <a href="#faq">{t('nav.faq')}</a>
      </div>
      <div class="footer-col">
        <span class="eyebrow">Company</span>
        <a href={localizedPath(lang, '/business')}>{t('nav.business')}</a>
        <a href={localizedPath(lang, '/contact')}>{t('nav.contact')}</a>
      </div>
      <div class="footer-col">
        <span class="eyebrow">{t('footer.legal')}</span>
        <a href="#">{t('footer.privacy')}</a>
        <a href="#">{t('footer.terms')}</a>
      </div>
    </nav>
  </div>

  <div class="container-x footer-bottom">
    <span>© {year} Consign · {t('footer.rights')}</span>
    <span class="footer-made">Made in Paris</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-bg);
    padding-block: 4rem 1.5rem;
    /* No top margin — the last section (10 reasons, also dark ink) flows directly into the footer */
    margin-top: 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-bg) 14%, transparent);
  }

  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-bg);
    font-weight: 800;
    font-size: 1.25rem;
  }
  .footer-brand .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--color-coral);
    position: relative;
  }
  .footer-brand .brand-mark::after {
    content: '';
    position: absolute;
    inset: 6px 6px auto auto;
    width: 6px;
    height: 6px;
    background: var(--color-yellow);
    border-radius: 50%;
  }
  .footer-tagline {
    margin-top: 0.85rem;
    color: color-mix(in srgb, var(--color-bg) 70%, transparent);
    font-size: 1rem;
    max-width: 28ch;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer-col .eyebrow {
    color: var(--color-yellow);
    margin-bottom: 0.3rem;
  }
  .footer-col a {
    color: color-mix(in srgb, var(--color-bg) 78%, transparent);
    text-decoration: none;
    font-weight: 500;
    transition: color 160ms ease;
  }
  .footer-col a:hover {
    color: var(--color-coral);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-bg) 55%, transparent);
  }
  .footer-made::before {
    content: '✺ ';
    color: var(--color-coral);
  }

  @media (min-width: 760px) {
    .footer-inner {
      grid-template-columns: 1.2fr 2fr;
      align-items: start;
    }
  }
</style>
