---
import { useTranslations, localizedPath } from '../i18n/ui';
import { PHONE_TEL, PHONE_DISPLAY, WHATSAPP_URL, EMAIL } from '../lib/site';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);
const year = new Date().getFullYear();
const ha = (hash: string) => (lang === 'fr' ? '/fr' : '') + '/#' + hash;
---

<footer class="site-footer">
  <div class="container-x footer-inner">
    <div class="footer-brand">
      <div class="brand">
        <span class="brand-name">Consign<span class="brand-dot">.</span></span>
      </div>
      <p class="footer-tagline">{t('footer.tagline')}</p>
    </div>

    <nav class="footer-nav" aria-label={lang === 'fr' ? 'Pied de page' : 'Footer'}>
      <div class="footer-col">
        <span class="eyebrow">{t('footer.product')}</span>
        <a href={ha('how')}>{t('nav.how')}</a>
        <a href={localizedPath(lang, '/pricing')}>{t('nav.pricing')}</a>
        <a href={ha('locations')}>{t('nav.locations')}</a>
        <a href={ha('faq')}>{t('nav.faq')}</a>
      </div>
      <div class="footer-col">
        <span class="eyebrow">{t('footer.company')}</span>
        <a href={localizedPath(lang, '/contact')}>{t('nav.contact')}</a>
      </div>
      <div class="footer-col">
        <span class="eyebrow">{t('footer.contact')}</span>
        <a href={PHONE_TEL}>{PHONE_DISPLAY}</a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href={`mailto:${EMAIL}`}>E‑mail</a>
      </div>
      <div class="footer-col">
        <span class="eyebrow">{t('footer.legal')}</span>
        <a href={localizedPath(lang, '/privacy')}>{t('footer.privacy')}</a>
        <a href={localizedPath(lang, '/terms')}>{t('footer.terms')}</a>
        <button type="button" class="footer-cookies" data-consent-open>{t('footer.cookies')}</button>
      </div>
    </nav>
  </div>

  <div class="container-x footer-bottom">
    <span>© {year} Consign · {t('footer.rights')}</span>
    <span class="footer-made">Made in Paris</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-bg);
    padding-block: 4rem 1.5rem;
    margin-top: 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-bg) 14%, transparent);
  }

  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .footer-brand .brand-name {
    color: #fff;
  }
  .footer-brand .brand-dot {
    color: var(--color-coral);
  }
  .footer-tagline {
    margin-top: 0.85rem;
    color: color-mix(in srgb, var(--color-bg) 70%, transparent);
    font-size: 1rem;
    max-width: 28ch;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1.5rem;
  }
  @media (min-width: 1000px) {
    .footer-nav { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer-col .eyebrow {
    color: var(--color-yellow);
    margin-bottom: 0.3rem;
  }
  .footer-col a,
  .footer-cookies {
    color: color-mix(in srgb, var(--color-bg) 82%, transparent);
    text-decoration: none;
    font-weight: 500;
    overflow-wrap: anywhere;
    transition: color 160ms ease;
  }
  .footer-cookies {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .footer-col a:hover,
  .footer-cookies:hover {
    color: var(--color-coral);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-bg) 55%, transparent);
  }
  .footer-made::before {
    content: '✺ ';
    color: var(--color-coral);
  }

  @media (min-width: 760px) {
    .footer-inner {
      grid-template-columns: 1.2fr 2fr;
      align-items: start;
    }
  }
</style>
