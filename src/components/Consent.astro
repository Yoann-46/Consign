---
/**
 * GDPR consent for Google Analytics. GA is NOT loaded until the visitor
 * accepts. Refusing is as easy as accepting (CNIL). Choice stored for
 * 6 months in localStorage; "Cookie settings" in the footer reopens it.
 */
import { useTranslations, localizedPath } from '../i18n/ui';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);
---

<div class="consent" id="consent" role="dialog" aria-live="polite" aria-labelledby="consent-text" hidden>
  <p id="consent-text" class="consent-text">
    {t('consent.text')}
    <a href={localizedPath(lang, '/privacy')}>{t('consent.more')}</a>
  </p>
  <div class="consent-actions">
    <button type="button" class="btn btn-ghost consent-btn" data-consent="denied">{t('consent.refuse')}</button>
    <button type="button" class="btn btn-ghost consent-btn" data-consent="granted">{t('consent.accept')}</button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'consign-consent';
    var GA_ID = 'G-MXXNH012J5';
    var SIX_MONTHS = 1000 * 60 * 60 * 24 * 182;
    var box = document.getElementById('consent');

    function read() {
      try {
        var v = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (v && v.at && Date.now() - v.at < SIX_MONTHS) return v.choice;
      } catch (e) {}
      return null;
    }
    function save(choice) {
      try { localStorage.setItem(KEY, JSON.stringify({ choice: choice, at: Date.now() })); } catch (e) {}
    }
    function loadGA() {
      if (window.__gaLoaded) return;
      window.__gaLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
    }
    function show() { if (box) box.hidden = false; }
    function hide() { if (box) box.hidden = true; }

    var choice = read();
    if (choice === 'granted') loadGA();
    else if (choice === null) show();

    document.addEventListener('click', function (e) {
      var el = e.target.closest && e.target.closest('[data-consent],[data-consent-open]');
      if (!el) return;
      if (el.hasAttribute('data-consent-open')) { show(); return; }
      var c = el.getAttribute('data-consent');
      save(c);
      hide();
      if (c === 'granted') loadGA();
      else if (window.__gaLoaded) {
        // Withdrawal: stop collection now and clear GA cookies.
        window['ga-disable-' + GA_ID] = true;
        document.cookie.split(';').forEach(function (k) {
          var name = k.split('=')[0].trim();
          if (name.indexOf('_ga') === 0) {
            document.cookie = name + '=; Max-Age=0; path=/; domain=.' + location.hostname.replace(/^www\./, '');
            document.cookie = name + '=; Max-Age=0; path=/';
          }
        });
      }
    });
  })();
</script>

<style>
  .consent {
    position: fixed;
    z-index: 60;
    left: var(--spacing-gutter);
    right: var(--spacing-gutter);
    bottom: calc(1rem + env(safe-area-inset-bottom));
    max-width: 560px;
    margin-inline: auto;
    padding: 1.1rem 1.25rem;
    background: var(--color-bg);
    color: var(--color-ink);
    border: 1.5px solid var(--color-ink);
    border-radius: 18px;
    box-shadow: 0 12px 32px -12px color-mix(in srgb, var(--color-ink) 35%, transparent);
  }
  .consent[hidden] { display: none; }
  /* Sit above the sticky Directions bar on mobile */
  @media (max-width: 759px) {
    .consent { bottom: calc(76px + env(safe-area-inset-bottom)); }
  }
  .consent-text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .consent-text a {
    color: var(--color-ink);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .consent-actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }
  .consent-btn {
    flex: 1;
    min-height: 44px;
    padding: 0.55rem 1rem;
    font-size: 0.95rem;
  }
</style>
