---
import { useTranslations } from '../i18n/ui';
import { GOOGLE_RATING, GOOGLE_REVIEWS_COUNT, GOOGLE_PLACE_URL } from '../lib/site';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);

// Rating, count and up to 5 real Google reviews, loaded from /api/reviews
// (cached a day). The static values are a fallback if the API is down.
const fmtRating = (r: number) => (lang === 'fr' ? r.toFixed(1).replace('.', ',') : r.toFixed(1));
---

<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="container-x">
    <header class="reviews-header" data-rev-anim="header" data-reveal>
      <h2 id="reviews-title" class="heading-display reviews-title">{t('reviews.title')}</h2>

      <div class="reviews-rating">
        <span class="rating-stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.5l2.95 6.59 7.05.61-5.38 4.69 1.66 6.86L12 17.77l-6.28 3.48 1.66-6.86-5.38-4.69 7.05-.61z" />
            </svg>
          ))}
        </span>
        <span class="rating-value" id="rev-rating">{fmtRating(GOOGLE_RATING)}</span>
        <span class="rating-google" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.45c-.28 1.45-1.13 2.68-2.4 3.5v2.91h3.87c2.26-2.08 3.57-5.15 3.57-8.65z" />
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.87-2.91c-1.07.72-2.45 1.16-4.06 1.16-3.12 0-5.77-2.1-6.71-4.94H1.29v3.1C3.26 21.3 7.31 24 12 24z" />
            <path fill="#FBBC05" d="M5.29 14.4c-.24-.72-.38-1.49-.38-2.4s.14-1.68.38-2.4V6.5H1.29A11.97 11.97 0 0 0 0 12c0 1.94.46 3.77 1.29 5.5l4-3.1z" />
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.59 1.79l3.43-3.43C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.5l4 3.1c.94-2.84 3.59-4.85 6.71-4.85z" />
          </svg>
          <span class="sr-only">Google</span>
        </span>
        <span class="rating-label">{t('reviews.rating.label')} · <span id="rev-count">{t('reviews.count').replace('{n}', String(GOOGLE_REVIEWS_COUNT))}</span></span>
      </div>
    </header>

    <ul
      class="reviews-list"
      id="rev-list"
      hidden
      data-lang={lang}
      data-count={t('reviews.count')}
      data-source={t('reviews.source')}
    ></ul>

    <div class="reviews-foot" data-rev-anim="foot" data-reveal>
      <a
        href={GOOGLE_PLACE_URL}
        class="btn btn-ghost reviews-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('reviews.cta')}
        <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .reviews {
    background: var(--color-bg-warm);
    padding-block: clamp(4.5rem, 9vw, 8rem);
    position: relative;
  }

  .container-x {
    position: relative;
    z-index: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Header */
  .reviews-header {
    margin-bottom: 2rem;
    max-width: 720px;
  }
  .reviews-title {
    font-size: clamp(2.25rem, 6.5vw, 4.5rem);
    margin: 0 0 1.5rem;
    color: var(--color-ink);
  }

  /* Big rating block */
  .reviews-rating {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.75rem 1.1rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
  }
  .rating-stars {
    display: inline-flex;
    gap: 0.15rem;
    color: var(--color-coral);
  }
  .rating-stars svg {
    width: 18px;
    height: 18px;
  }
  .rating-value {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .rating-google {
    display: inline-flex;
    align-items: center;
  }
  .rating-google svg {
    display: block;
  }
  .rating-label {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    font-weight: 500;
  }

  /* Review cards (filled by the script below) */
  .reviews-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .reviews-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .reviews-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .reviews-list :global(.rev) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem 1.4rem 1.2rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-ink);
    border-radius: 18px;
  }
  .reviews-list :global(.rev-stars) {
    color: var(--color-coral);
    letter-spacing: 0.1em;
    font-size: 0.95rem;
  }
  .reviews-list :global(.rev-text) {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }
  .reviews-list :global(.rev-meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }
  .reviews-list :global(.rev-author) {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .reviews-list :global(a.rev-author:hover) { text-decoration: underline; }

  /* Footer CTA */
  .reviews-foot {
    display: flex;
  }
  /* .reviews-cta inherits the new global .btn sizes */

</style>


<script>
  type Rev = { rating: number | null; text: string; author: string; authorUri: string | null; publishTime: string | null };
  const list = document.getElementById('rev-list') as HTMLUListElement | null;
  if (list) {
    const lang = list.dataset.lang === 'fr' ? 'fr' : 'en';
    const rtf = new Intl.RelativeTimeFormat(lang, { numeric: 'auto' });
    const ago = (iso: string | null) => {
      if (!iso) return '';
      const days = Math.round((Date.parse(iso) - Date.now()) / 86_400_000);
      if (Math.abs(days) < 7) return rtf.format(days, 'day');
      if (Math.abs(days) < 30) return rtf.format(Math.round(days / 7), 'week');
      if (Math.abs(days) < 365) return rtf.format(Math.round(days / 30), 'month');
      return rtf.format(Math.round(days / 365), 'year');
    };
    const el = (tag: string, cls: string, text?: string) => {
      const e = document.createElement(tag);
      e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    };
    fetch('/api/reviews')
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d: { rating: number | null; count: number | null; reviews: Rev[] }) => {
        if (typeof d.rating === 'number') {
          const v = d.rating.toFixed(1);
          document.getElementById('rev-rating')!.textContent = lang === 'fr' ? v.replace('.', ',') : v;
        }
        if (typeof d.count === 'number') {
          document.getElementById('rev-count')!.textContent = list.dataset.count!.replace('{n}', String(d.count));
        }
        const reviews = (d.reviews ?? []).filter((r) => r.text);
        if (!reviews.length) return;
        for (const r of reviews) {
          const li = el('li', 'rev');
          const n = Math.max(0, Math.min(5, Math.round(r.rating ?? 5)));
          const stars = el('span', 'rev-stars', '★'.repeat(n) + '☆'.repeat(5 - n));
          stars.setAttribute('aria-label', `${n}/5`);
          li.append(stars, el('p', 'rev-text', r.text));
          const meta = el('p', 'rev-meta');
          const author = r.authorUri ? (el('a', 'rev-author', r.author) as HTMLAnchorElement) : el('span', 'rev-author', r.author);
          if (r.authorUri) {
            (author as HTMLAnchorElement).href = r.authorUri;
            (author as HTMLAnchorElement).target = '_blank';
            (author as HTMLAnchorElement).rel = 'noopener noreferrer';
          }
          meta.append(author, el('span', '', `${list.dataset.source} · ${ago(r.publishTime)}`));
          li.append(meta);
          list.append(li);
        }
        list.hidden = false;
      })
      .catch(() => {});
  }
</script>
