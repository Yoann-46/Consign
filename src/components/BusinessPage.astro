---
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);

const cases = [
  {
    icon: 'hotel',
    title: t('business.case1.title'),
    desc: t('business.case1.desc'),
    accent: 'coral',
  },
  {
    icon: 'building',
    title: t('business.case2.title'),
    desc: t('business.case2.desc'),
    accent: 'yellow',
  },
  {
    icon: 'key',
    title: t('business.case3.title'),
    desc: t('business.case3.desc'),
    accent: 'coral',
  },
] as const;

const benefits = [
  { title: t('business.benefit1.title'), desc: t('business.benefit1.desc'), num: '01', accent: 'coral' },
  { title: t('business.benefit2.title'), desc: t('business.benefit2.desc'), num: '02', accent: 'yellow' },
  { title: t('business.benefit3.title'), desc: t('business.benefit3.desc'), num: '03', accent: 'coral' },
  { title: t('business.benefit4.title'), desc: t('business.benefit4.desc'), num: '04', accent: 'yellow' },
] as const;

const partnerSteps = [
  { num: '01', title: t('business.step1.title'), desc: t('business.step1.desc') },
  { num: '02', title: t('business.step2.title'), desc: t('business.step2.desc') },
  { num: '03', title: t('business.step3.title'), desc: t('business.step3.desc') },
  { num: '04', title: t('business.step4.title'), desc: t('business.step4.desc') },
] as const;
---

<!-- HERO -->
<section class="biz-hero" aria-labelledby="biz-title">
  <div class="biz-hero-bg" aria-hidden="true"></div>
  <div class="container-x">
    <header class="biz-header" data-biz-anim="header">
      <span class="eyebrow biz-eyebrow">{t('business.eyebrow')}</span>
      <h1 id="biz-title" class="heading-display biz-title">
        {t('business.title')} <span class="biz-title-accent">{t('business.title.accent')}</span>
      </h1>
      <p class="biz-subtitle">{t('business.subtitle')}</p>
      <a href="#biz-contact" class="btn btn-primary biz-cta">
        {t('business.cta')}
        <span aria-hidden="true">↓</span>
      </a>
    </header>
  </div>
</section>

<!-- USE CASES -->
<section class="biz-cases" aria-labelledby="biz-cases-title">
  <div class="container-x">
    <header class="biz-section-header" data-biz-anim="cases-header">
      <span class="eyebrow biz-section-eyebrow">{t('business.cases.eyebrow')}</span>
      <h2 id="biz-cases-title" class="heading-display biz-section-title">
        Hotels. Aparthotels. Airbnb managers.
      </h2>
    </header>
    <ul class="biz-cases-list">
      {cases.map((c) => (
        <li class={`biz-case accent-${c.accent}`} data-biz-anim="case">
          <span class="biz-case-icon" aria-hidden="true">
            {c.icon === 'hotel' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 21V8l9-5 9 5v13" />
                <path d="M3 21h18" />
                <rect x="9" y="13" width="6" height="8" />
                <path d="M7 9h2M11 9h2M15 9h2M7 12h2M15 12h2" />
              </svg>
            )}
            {c.icon === 'building' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 21V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v16" />
                <path d="M15 9h3a2 2 0 0 1 2 2v10" />
                <path d="M3 21h18" />
                <path d="M8 7h2M8 11h2M8 15h2" />
              </svg>
            )}
            {c.icon === 'key' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="7.5" cy="14.5" r="4" />
                <path d="m11 11 8.5-8.5" />
                <path d="m14.5 7.5 3 3" />
                <path d="m17 5 3 3" />
              </svg>
            )}
          </span>
          <h3 class="biz-case-title">{c.title}</h3>
          <p class="biz-case-desc">{c.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- BENEFITS -->
<section class="biz-benefits" aria-labelledby="biz-benefits-title">
  <div class="container-x">
    <header class="biz-section-header" data-biz-anim="benefits-header">
      <span class="eyebrow biz-section-eyebrow biz-section-eyebrow--light">{t('business.benefits.eyebrow')}</span>
      <h2 id="biz-benefits-title" class="heading-display biz-section-title biz-section-title--light">
        {t('business.benefits.title')}
      </h2>
    </header>
    <ol class="biz-benefits-list">
      {benefits.map((b) => (
        <li class={`biz-benefit accent-${b.accent}`} data-biz-anim="benefit">
          <span class="biz-benefit-num">{b.num}</span>
          <h3 class="biz-benefit-title">{b.title}</h3>
          <p class="biz-benefit-desc">{b.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- HOW PARTNERSHIPS WORK -->
<section class="biz-steps" aria-labelledby="biz-steps-title">
  <div class="container-x">
    <header class="biz-section-header" data-biz-anim="steps-header">
      <span class="eyebrow biz-section-eyebrow">{t('business.steps.eyebrow')}</span>
      <h2 id="biz-steps-title" class="heading-display biz-section-title">
        From spot to revenue, in 4 steps.
      </h2>
    </header>
    <ol class="biz-steps-list">
      {partnerSteps.map((s, i) => (
        <li class="biz-step" data-biz-anim="step">
          <span class="biz-step-num">{s.num}</span>
          <h3 class="biz-step-title">{s.title}</h3>
          <p class="biz-step-desc">{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- CONTACT -->
<section class="biz-contact" id="biz-contact" aria-labelledby="biz-contact-title">
  <div class="container-x">
    <div class="biz-contact-card" data-biz-anim="contact">
      <header>
        <span class="eyebrow biz-contact-eyebrow">{t('business.eyebrow')}</span>
        <h2 id="biz-contact-title" class="heading-display biz-contact-title">
          {t('business.contact.title')}
        </h2>
        <p class="biz-contact-subtitle">{t('business.contact.subtitle')}</p>
      </header>

      <form class="biz-form" id="biz-form" novalidate>
        <div class="form-grid">
          <label class="field field-half">
            <span class="field-label">{t('business.contact.name')}</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label class="field field-half">
            <span class="field-label">{t('business.contact.business')}</span>
            <input type="text" name="business" required autocomplete="organization" />
          </label>
          <label class="field field-half">
            <span class="field-label">{t('business.contact.email')}</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label class="field field-half">
            <span class="field-label">{t('business.contact.spot')}</span>
            <input type="text" name="spot" autocomplete="street-address" />
          </label>
          <label class="field">
            <span class="field-label">{t('business.contact.message')}</span>
            <textarea name="message" rows="4"></textarea>
          </label>
        </div>
        <button type="submit" class="btn btn-primary">
          {t('business.contact.submit')}
          <span aria-hidden="true">→</span>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  /* HERO */
  .biz-hero {
    position: relative;
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem);
    overflow: hidden;
    isolation: isolate;
  }
  .biz-hero-bg {
    position: absolute;
    inset: -10%;
    z-index: -1;
    background:
      radial-gradient(circle at 80% 20%, color-mix(in srgb, var(--color-yellow) 40%, transparent), transparent 60%),
      radial-gradient(circle at 10% 80%, color-mix(in srgb, var(--color-coral) 14%, transparent), transparent 55%);
    filter: blur(40px);
    pointer-events: none;
  }
  .biz-header {
    max-width: 920px;
    opacity: 0;
    transform: translateY(20px);
  }
  .biz-eyebrow {
    color: var(--color-coral-dark);
    margin-bottom: 1rem;
    display: inline-block;
  }
  .biz-title {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    margin: 0 0 1.5rem;
    color: var(--color-ink);
    line-height: 0.98;
  }
  .biz-title-accent {
    color: var(--color-coral);
  }
  .biz-subtitle {
    margin: 0 0 2rem;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 58ch;
  }
  .biz-cta { /* inherits btn sizing */ }

  /* Shared section header */
  .biz-section-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    max-width: 760px;
    opacity: 0;
    transform: translateY(20px);
  }
  .biz-section-eyebrow {
    color: var(--color-coral-dark);
    margin-bottom: 0.85rem;
    display: inline-block;
  }
  .biz-section-eyebrow--light {
    color: var(--color-coral);
  }
  .biz-section-title {
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    margin: 0;
    color: var(--color-ink);
    line-height: 1.05;
  }
  .biz-section-title--light {
    color: var(--color-bg);
  }

  /* USE CASES */
  .biz-cases {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background: var(--color-bg-warm);
  }
  .biz-cases-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .biz-case {
    background: var(--color-bg);
    border: 1.5px solid var(--color-ink);
    border-radius: 20px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    opacity: 0;
    transform: translateY(20px);
  }
  .biz-case.accent-coral { --accent: var(--color-coral); }
  .biz-case.accent-yellow { --accent: var(--color-yellow); }
  .biz-case-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--accent);
    color: var(--color-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--color-ink);
  }
  .accent-coral .biz-case-icon { color: white; }
  .biz-case-icon svg { width: 24px; height: 24px; }
  .biz-case-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .biz-case-desc {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }
  @media (min-width: 800px) {
    .biz-cases-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* BENEFITS — dark section */
  .biz-benefits {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .biz-benefits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-bg) 16%, transparent);
  }
  .biz-benefit {
    padding: 1.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-bg) 16%, transparent);
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'num title'
      'num desc';
    column-gap: 1.5rem;
    row-gap: 0.4rem;
    opacity: 0;
    transform: translateY(20px);
  }
  .biz-benefit-num {
    grid-area: num;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .biz-benefit.accent-coral .biz-benefit-num { color: var(--color-coral); }
  .biz-benefit.accent-yellow .biz-benefit-num { color: var(--color-yellow); }
  .biz-benefit-title {
    grid-area: title;
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--color-bg);
    align-self: end;
  }
  .biz-benefit-desc {
    grid-area: desc;
    margin: 0;
    color: color-mix(in srgb, var(--color-bg) 70%, transparent);
    line-height: 1.5;
  }
  @media (min-width: 900px) {
    .biz-benefits-list {
      grid-template-columns: repeat(2, 1fr);
    }
    .biz-benefit {
      padding: 2rem 2.5rem 2rem 0;
      border-right: 1px solid color-mix(in srgb, var(--color-bg) 16%, transparent);
    }
    .biz-benefit:nth-child(2n) {
      padding-left: 2.5rem;
      padding-right: 0;
      border-right: none;
    }
    .biz-benefit:nth-last-child(-n+2) {
      border-bottom: none;
    }
  }

  /* STEPS */
  .biz-steps {
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--color-bg);
  }
  .biz-steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    counter-reset: step;
  }
  .biz-step {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'num title'
      'num desc';
    column-gap: 1.25rem;
    row-gap: 0.4rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-rule);
    opacity: 0;
    transform: translateY(20px);
  }
  .biz-step:first-child { border-top: none; padding-top: 0; }
  .biz-step-num {
    grid-area: num;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-coral);
    min-width: 2.6ch;
  }
  .biz-step-title {
    grid-area: title;
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    align-self: center;
  }
  .biz-step-desc {
    grid-area: desc;
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }
  @media (min-width: 900px) {
    .biz-steps-list {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
    .biz-step {
      grid-template-columns: 1fr;
      grid-template-areas:
        'num'
        'title'
        'desc';
      row-gap: 1rem;
      padding: 0 2rem 0 0;
      border-top: none;
      border-right: 1px solid var(--color-rule);
    }
    .biz-step:first-child { padding-top: 0; }
    .biz-step:last-child { border-right: none; padding-right: 0; }
    .biz-step:not(:first-child) { padding-left: 2rem; }
    .biz-step-num {
      font-size: 2.5rem;
    }
  }

  /* CONTACT */
  .biz-contact {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--color-bg-warm);
  }
  .biz-contact-card {
    max-width: 760px;
    margin: 0 auto;
    background: var(--color-bg);
    border: 1.5px solid var(--color-ink);
    border-radius: 22px;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    opacity: 0;
    transform: translateY(20px);
  }
  .biz-contact-eyebrow {
    color: var(--color-coral-dark);
    margin-bottom: 0.85rem;
    display: inline-block;
  }
  .biz-contact-title {
    font-size: clamp(1.85rem, 4vw, 2.5rem);
    margin: 0 0 0.85rem;
    color: var(--color-ink);
  }
  .biz-contact-subtitle {
    margin: 0 0 1.75rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  /* Reused field styles (mirror Contact form) */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
    .field { grid-column: span 2; }
    .field-half { grid-column: span 1; }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-rule);
    border-radius: 12px;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-ink);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .field textarea {
    resize: vertical;
    min-height: 110px;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-coral);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-coral) 22%, transparent);
  }
  .biz-form button[type="submit"] {
    margin-top: 1.5rem;
  }
</style>

<script is:inline define:vars={{ email: 'consignlocker@gmail.com' }}>
  document.getElementById('biz-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const business = String(data.get('business') || '').trim();
    const userEmail = String(data.get('email') || '').trim();
    const spot = String(data.get('spot') || '').trim();
    const message = String(data.get('message') || '').trim();

    if (!name || !business || !userEmail) {
      form.reportValidity();
      return;
    }

    const subj = `[Partnership] ${business} — ${name}`;
    const body = [
      `Name: ${name}`,
      `Business: ${business}`,
      `Email: ${userEmail}`,
      spot ? `Spot: ${spot}` : null,
      '',
      message,
    ].filter(Boolean).join('\n');
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subj)}&body=${encodeURIComponent(body)}`;
  });
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const header = document.querySelector<HTMLElement>('[data-biz-anim="header"]');
  if (header) {
    if (reduce) gsap.set(header, { opacity: 1, y: 0 });
    else gsap.to(header, { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out' });
  }

  function revealOnScroll(selector: string, trigger: string, stagger = 0.1) {
    const els = document.querySelectorAll<HTMLElement>(selector);
    if (!els.length) return;
    if (reduce) {
      gsap.set(els, { opacity: 1, y: 0 });
    } else {
      gsap.to(els, {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        stagger,
        scrollTrigger: { trigger, start: 'top 78%', once: true },
      });
    }
  }

  revealOnScroll('[data-biz-anim="cases-header"]', '.biz-cases', 0);
  revealOnScroll('[data-biz-anim="case"]', '.biz-cases-list', 0.12);
  revealOnScroll('[data-biz-anim="benefits-header"]', '.biz-benefits', 0);
  revealOnScroll('[data-biz-anim="benefit"]', '.biz-benefits-list', 0.1);
  revealOnScroll('[data-biz-anim="steps-header"]', '.biz-steps', 0);
  revealOnScroll('[data-biz-anim="step"]', '.biz-steps-list', 0.1);
  revealOnScroll('[data-biz-anim="contact"]', '.biz-contact', 0);
</script>
