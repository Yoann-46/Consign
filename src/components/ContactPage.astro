---
import { useTranslations } from '../i18n/ui';

const lang = Astro.currentLocale ?? 'en';
const t = useTranslations(lang);

const methods = [
  {
    icon: 'mail',
    label: t('contact.method.email.label'),
    value: t('contact.method.email.value'),
    hint: t('contact.method.email.hint'),
    href: `mailto:${t('contact.method.email.value')}`,
    accent: 'coral',
  },
  {
    icon: 'whatsapp',
    label: t('contact.method.whatsapp.label'),
    value: t('contact.method.whatsapp.value'),
    hint: t('contact.method.whatsapp.hint'),
    href: `https://wa.me/${t('contact.method.whatsapp.value').replace(/[^0-9]/g, '')}`,
    accent: 'yellow',
  },
  {
    icon: 'pin',
    label: t('contact.method.visit.label'),
    value: t('contact.method.visit.value'),
    hint: t('contact.method.visit.hint'),
    href: 'https://www.google.com/maps/dir/?api=1&destination=57+rue+de+Cl%C3%A9ry+75002+Paris',
    accent: 'coral',
  },
] as const;
---

<section class="contact-hero" aria-labelledby="contact-title">
  <div class="container-x">
    <header class="contact-header" data-contact-anim="header">
      <span class="eyebrow contact-eyebrow">{t('contact.eyebrow')}</span>
      <h1 id="contact-title" class="heading-display contact-title">
        {t('contact.title')}
      </h1>
      <p class="contact-subtitle">{t('contact.subtitle')}</p>
    </header>

    <ul class="contact-methods" data-contact-anim="methods">
      {methods.map((m) => (
        <li class={`method accent-${m.accent}`}>
          <a class="method-link" href={m.href} target={m.icon !== 'mail' ? '_blank' : undefined} rel="noopener noreferrer">
            <span class="method-icon" aria-hidden="true">
              {m.icon === 'mail' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m4 7 8 6 8-6" />
                </svg>
              )}
              {m.icon === 'whatsapp' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12a8.5 8.5 0 0 1-12.7 7.4L3 21l1.7-5A8.5 8.5 0 1 1 21 12Z" />
                  <path d="M9 9c.4 1.4 1.4 2.7 2.6 3.7 1 .9 2.3 1.6 3.7 2 .5.1.9-.1 1.2-.5l.5-.6c.3-.3.7-.4 1-.2l1.4.7c.3.2.5.5.5.9 0 1-.7 1.9-1.6 2.2-.6.2-1.4.1-2.2-.2-2.5-.9-4.6-2.7-6-5-.5-.8-.6-1.5-.4-2.1.3-.9 1.1-1.6 2.1-1.7.3 0 .7.2.9.5l.7 1.4c.2.3.1.7-.2 1l-.6.5c-.4.3-.6.7-.5 1.2Z" />
                </svg>
              )}
              {m.icon === 'pin' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              )}
            </span>
            <div class="method-body">
              <span class="method-label">{m.label}</span>
              <span class="method-value">{m.value}</span>
              <span class="method-hint">{m.hint}</span>
            </div>
            <span class="method-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>

    <form class="contact-form" id="contact-form" data-contact-anim="form" novalidate>
      <h2 class="form-title">{t('contact.form.title')}</h2>

      <div class="form-grid">
        <label class="field field-half">
          <span class="field-label">{t('contact.form.name')}</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label class="field field-half">
          <span class="field-label">{t('contact.form.email')}</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label class="field">
          <span class="field-label">{t('contact.form.subject')}</span>
          <select name="subject" required>
            <option value={t('contact.form.subject.general')}>{t('contact.form.subject.general')}</option>
            <option value={t('contact.form.subject.support')}>{t('contact.form.subject.support')}</option>
            <option value={t('contact.form.subject.partnership')}>{t('contact.form.subject.partnership')}</option>
          </select>
        </label>

        <label class="field">
          <span class="field-label">{t('contact.form.message')}</span>
          <textarea name="message" rows="5" required></textarea>
        </label>
      </div>

      <div class="form-foot">
        <button type="submit" class="btn btn-primary form-submit">
          {t('contact.form.submit')}
          <span aria-hidden="true">→</span>
        </button>
        <p class="form-note">{t('contact.form.note')}</p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact-hero {
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(4rem, 8vw, 7rem);
    position: relative;
    overflow: hidden;
  }
  .contact-hero::before {
    content: '';
    position: absolute;
    inset: -10% -10% auto auto;
    width: 28rem;
    height: 28rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-yellow) 38%, transparent), transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }
  .contact-hero > .container-x { position: relative; z-index: 1; }

  .contact-header {
    max-width: 740px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    opacity: 0;
    transform: translateY(20px);
  }
  .contact-eyebrow {
    color: var(--color-coral-dark);
    margin-bottom: 0.85rem;
    display: inline-block;
  }
  .contact-title {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    margin: 0 0 1.25rem;
    color: var(--color-ink);
  }
  .contact-subtitle {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    max-width: 58ch;
  }

  /* Method cards */
  .contact-methods {
    list-style: none;
    padding: 0;
    margin: 0 0 clamp(3rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    opacity: 0;
    transform: translateY(20px);
  }
  .method {
    /* Wrapper exists for accent CSS variable scoping */
  }
  .method.accent-coral { --accent: var(--color-coral); }
  .method.accent-yellow { --accent: var(--color-yellow-deep); }
  .method-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 1.15rem;
    padding: 1.15rem 1.35rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-ink);
    border-radius: 16px;
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 200ms ease, background 200ms ease;
  }
  .method-link:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--accent) 8%, var(--color-bg));
  }
  .method-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--accent);
    color: var(--color-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--color-ink);
  }
  .accent-coral .method-icon { color: white; }
  .method-icon svg { width: 22px; height: 22px; }
  .method-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .method-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .method-value {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .method-hint {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }
  .method-arrow {
    font-size: 1.1rem;
    color: var(--color-ink-faint);
    transition: transform 200ms ease, color 200ms ease;
  }
  .method-link:hover .method-arrow {
    color: var(--color-ink);
    transform: translate(2px, -2px);
  }

  @media (min-width: 760px) {
    .contact-methods {
      grid-template-columns: repeat(3, 1fr);
    }
    .method-link {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
      align-items: start;
      row-gap: 0.85rem;
      padding: 1.5rem 1.35rem 1.35rem;
    }
    .method-arrow {
      position: absolute;
      top: 1.2rem;
      right: 1.2rem;
    }
    .method { position: relative; }
  }

  /* Form */
  .contact-form {
    border: 1.5px solid var(--color-ink);
    border-radius: 22px;
    background: var(--color-bg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 760px;
    opacity: 0;
    transform: translateY(20px);
  }
  .form-title {
    margin: 0 0 1.5rem;
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
    .field { grid-column: span 2; }
    .field-half { grid-column: span 1; }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-rule);
    border-radius: 12px;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-ink);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .field textarea {
    resize: vertical;
    min-height: 130px;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-coral);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-coral) 22%, transparent);
  }
  .field select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-ink) 50%),
                      linear-gradient(135deg, var(--color-ink) 50%, transparent 50%);
    background-position: calc(100% - 18px) 1.15rem, calc(100% - 13px) 1.15rem;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }

  .form-foot {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: flex-start;
  }
  .form-submit {
    align-self: flex-start;
  }
  .form-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-ink-faint);
    max-width: 60ch;
    line-height: 1.5;
  }
</style>

<script is:inline define:vars={{ email: 'hello@consign.paris' }}>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const userEmail = String(data.get('email') || '').trim();
    const subject = String(data.get('subject') || '').trim();
    const message = String(data.get('message') || '').trim();

    if (!name || !userEmail || !message) {
      form.reportValidity();
      return;
    }

    const subj = `[${subject}] ${name}`;
    const body = `Name: ${name}\nEmail: ${userEmail}\n\n${message}`;
    const mailto = `mailto:${email}?subject=${encodeURIComponent(subj)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
  });
</script>

<script>
  import { gsap } from 'gsap';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('[data-contact-anim]');

  if (reduce) {
    gsap.set(targets, { opacity: 1, y: 0 });
  } else {
    gsap.to(targets, {
      opacity: 1,
      y: 0,
      duration: 0.95,
      ease: 'power3.out',
      stagger: 0.15,
    });
  }
</script>
